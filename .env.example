NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
API_PUBLIC_URL=http://localhost:3333
API_PORT=3333
# Installed version (/backoffice): the Docker build reads the commit from the
# git checkout automatically. Do not set GIT_SHA here — a runtime value is
# ignored. See docs/setup/update.md#versão-instalada.
# ⚠️ Gatilhos de conversão (obrigatório no caminho do aluno / produção):
# os defaults abaixo são "false" de propósito para dev local. Para liberar
# "Gatilhos de conversão -> Nova regra" (UAZAPI, NOD API, WAHA, Z-API,
# Umbler, Gupshup e qualquer origem que use gatilhos), defina as flags
# true e preencha INBOUND_WEBHOOK_ENCRYPTION_KEY. Sem isso, leads/webhooks
# podem chegar e mesmo assim Nova regra não aparece. Checklist completo:
# docs/setup/environment.md#gatilhos-de-conversão--obrigatórias-no-caminho-do-aluno
INBOUND_WEBHOOKS_ENABLED=false
# Base64 de 32 bytes (44 caracteres terminando em "="). Gere com:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
INBOUND_WEBHOOK_ENCRYPTION_KEY=
INBOUND_WEBHOOK_REPLAY_ENABLED=false
# Defina "true" em produção (Dokploy) junto com os dois acima.
INBOUND_WEBHOOK_PRODUCTION_ENABLED=false
INBOUND_CONVERSION_RULES_ENABLED=false
INBOUND_CONVERSION_PRODUCTION_ENABLED=false

# Optional published-report integration. Runtime only; unset disables it.
# Configure a dedicated random bearer token outside source control.
REPORT_SYNC_BEARER_TOKEN=
# Scoped JSON configuration and deployment/cutover instructions:
# docs/integrations/report-sync.md
REPORT_SYNC_CONFIG_JSON=
WPPTRACK_API_SLOW_REQUEST_MS=1500
WPPTRACK_API_SLOW_REPORT_QUERY_MS=750
WPPTRACK_WEB_SLOW_REQUEST_MS=1500
WPPTRACK_WEB_PROVIDER_STATUS_TIMEOUT_MS=2000
WPPTRACK_EXTERNAL_SYNC_ENABLED=true
WPPTRACK_EXTERNAL_SYNC_INTERVAL_MINUTES=1
WPPTRACK_EXTERNAL_SYNC_INITIAL_DELAY_SECONDS=60
WPPTRACK_EXTERNAL_SYNC_CONNECTOR_LIMIT=50
WPPTRACK_EXTERNAL_SYNC_ROW_BATCH_SIZE=200
WPPTRACK_EXTERNAL_MYSQL_CONNECT_TIMEOUT_MS=5000
WPPTRACK_EXTERNAL_MYSQL_QUERY_TIMEOUT_MS=10000

DATABASE_URL=postgresql://rastrackdash:rastrackdash@localhost:5432/rastrackdash
REDIS_URL=redis://localhost:6379
EXTERNAL_CONNECTOR_ENCRYPTION_KEY=replace-me-external-connector-encryption-key

JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_COOKIE_DOMAIN=localhost
AUTH_EXPOSE_DEV_TOKENS=false
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=RastrackDash
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com

WPPTRACK_PLATFORM_ADMIN_EMAILS=

# First platform owner bootstrap (optional). Set both in the API service env;
# the account is created when the API starts. Remove the password after first use.
SETUP_PLATFORM_ADMIN_EMAIL=
SETUP_PLATFORM_ADMIN_PASSWORD=
# Set exactly "true" only to promote an existing account intentionally.
SETUP_PLATFORM_ADMIN_CONFIRM_EXISTING=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-me-google-state-secret

META_APP_ID=
# App Secret do app Meta (NAO e o token permanente do Graph). Valida o header
# x-hub-signature-256. Opcional enquanto uma conexao "Meta WhatsApp (Cloud
# API)" estiver em observacao; OBRIGATORIO antes de ativar o envio automatico
# dessa conexao - sem ele, a API passa a recusar os POSTs da Meta com 404.
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=replace-me-meta-token-encryption-key
# Usado SOMENTE pelo webhook de Meta Ads (/webhooks/meta). O webhook do
# Meta WhatsApp (Cloud API) usa um Verify token gerado por conexao na UI.
META_WEBHOOK_VERIFY_TOKEN=
WPPTRACK_META_AUTO_SYNC_ENABLED=true
WPPTRACK_META_AUTO_SYNC_INTERVAL_MINUTES=180
WPPTRACK_META_AUTO_SYNC_INITIAL_DELAY_SECONDS=60
WPPTRACK_META_AUTO_SYNC_LOOKBACK_DAYS=7
WPPTRACK_META_AUTO_SYNC_BATCH_LIMIT=100
WPPTRACK_REPORT_TIMEZONE=America/Sao_Paulo

UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_AUTH_TOKEN=

# WhatsApp providers (F5 plan, apps/api/src/integrations/whatsapp-providers):
# New uazapi_byo connections use their own encrypted URL/token from the UI.
# UAZAPI_* above are legacy defaults; report sync requires individual config.
# nod_api is the PalmUP-managed broker (below). waha and zapi are pure BYO
# adapters for a self-hosted WAHA (devlikeape/waha) instance and a Z-API
# (z-api.cloud) instance, respectively (below).

# WAHA (devlikeape/waha) BYO adapter — F5.4. Pure self-host, no PalmUP
# broker/admin token involved. WAHA_SESSION defaults to "default" if unset.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# Z-API (z-api.cloud) BYO adapter — F5.5. Pure BYO instance, no PalmUP
# broker/admin token involved.
ZAPI_BASE_URL=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# License client (F4.1) — talks to the private PalmUP license server. The
# student edition is fail-closed: with LICENSE_SERVER_URL set and no valid
# activation, reads work but every write answers 423. Clear LICENSE_SERVER_URL
# (not just the key) to develop this template with licensing switched off.
LICENSE_SERVER_URL=https://wpptrack-api.rastrack.app
# Received by email/WhatsApp after purchase. Do not commit a real value.
LICENSE_KEY=
# The admin account email this license is bound to.
LICENSE_ACCOUNT_IDENTITY=

# NOD API broker (PalmUP-managed Uazapi fleet via license key — F5.3b)
# Uses LICENSE_KEY + fingerprint; never set UAZAPI_ADMIN_TOKEN here.
NOD_API_BROKER_URL=https://wpptrack-api.rastrack.app

# WhatsApp disconnect alerts (F5.7) — streak of consecutive disconnected
# health checks before alerting once per streak; in-memory (resets on restart).
DISCONNECT_ALERTS_ENABLED=false
DISCONNECT_ALERT_STREAK=3
DISCONNECT_ALERT_INTERVAL_MS=900000
OPS_ALERT_WEBHOOK_URL=

# Whitelabel (F6.2) — student agency branding. Read server-side by
# apps/web/src/lib/brand.ts and passed as props into the (client) app shell;
# nothing here is exposed via NEXT_PUBLIC_. The footer residual
# ("RastrackDash · powered by PalmUP") is NOT controlled by any of these
# vars and cannot be hidden.
BRAND_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR=#0F766E
