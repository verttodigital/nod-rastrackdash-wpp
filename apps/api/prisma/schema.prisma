/// RastrackDash license server (PalmUP). Raw key is never persisted after issue.
/// Expiry is derived from expiresAt at validation time; it is not a stored status.

/// Short-lived encrypted copy of the raw key (7d TTL) so admin resend can redeliver
/// without ever storing the raw key in the License row itself.

/// Telemetry of student instances. Unlimited fingerprints for the same bound account.

/// Idempotent Guru (and future provider) webhook audit. Invalid signatures must not mutate License.

/// Local (client-side) runtime state for the license-client module (F4.1). Single row keyed by
/// `id = "singleton"`. Populated by talking to the private PalmUP license server over HTTP; this
/// public template contains no license-server logic itself. `status` is intentionally a plain
/// string ("active" | "grace" | "blocked" | "unlicensed") rather than a DB enum so the client can
/// evolve independently of the (private) server's own License/LicenseStatus vocabulary above.
model LicenseState {
  id               String    @id @default("singleton")
  fingerprint      String
  accountIdentity  String
  licenseKeyPrefix String
  signedCache      String?   @db.Text
  cacheValidUntil  DateTime?
  lastCheckedAt    DateTime?
  lastError        String?   @db.Text
  status           String    @default("unlicensed")
  expiresAt        DateTime?
  bound            Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Durable publication context; all API access is scoped to its configured source.
model ReportSyncSource {
  id               String              @id
  workspaceId      String
  tenantId         String
  cutoverAt        DateTime?
  baselineId       String?
  baselineComplete Boolean             @default(false)
  baselineManifest Json?
  baselineParts    Json                @default("{}")
  activatedAt      DateTime?
  updatedAt        DateTime            @updatedAt
  intents          ReportSyncIntent[]
  stages           ReportSyncStage[]
  bindings         ReportSyncBinding[]

  @@unique([id, workspaceId, tenantId])
  @@unique([id, workspaceId])
}

model ReportSyncIntent {
  id                   String           @id
  sourceId             String
  workspaceId          String
  tenantId             String
  publicationId        String
  publicationVersion   Int
  sourceLeadId         String
  payloadHash          String
  encryptedPayload     String
  payloadIv            String
  payloadTag           String
  encryptionKeyVersion Int
  mode                 String
  status               String           @default("pending")
  reasonCode           String?
  whatsappInstanceId   String?
  contactKey           String?
  finalLabelVerified   Boolean          @default(false)
  nextAttemptAt        DateTime?
  attempts             Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  source               ReportSyncSource @relation(fields: [sourceId, workspaceId, tenantId], references: [id, workspaceId, tenantId], onDelete: Restrict)

  @@unique([sourceId, tenantId, publicationId, sourceLeadId])
  @@index([sourceId, status, nextAttemptAt])
  @@index([sourceId, sourceLeadId, publicationVersion])
}

model ReportSyncStage {
  deliveryAttempts   Int              @default(0)
  id                 String           @id
  sourceId           String
  workspaceId        String
  tenantId           String
  sourceLeadId       String
  stage              String
  occurredAt         DateTime?
  intentId           String?
  whatsappInstanceId String?
  contactKey         String?
  labelId            String?
  providerRuleId     String?
  status             String           @default("pending")
  reasonCode         String?
  executionId        String?
  conversionEventId  String?
  metaAcceptedAt     DateTime?
  updatedAt          DateTime         @updatedAt
  source             ReportSyncSource @relation(fields: [sourceId, workspaceId, tenantId], references: [id, workspaceId, tenantId], onDelete: Restrict)

  @@unique([sourceId, tenantId, sourceLeadId, stage])
  @@index([workspaceId, whatsappInstanceId, contactKey, status])
}

model ReportSyncBinding {
  id                 String                       @id
  sourceId           String
  workspaceId        String
  whatsappInstanceId String
  stage              String
  labelId            String
  providerRuleId     String                       @unique
  source             ReportSyncSource             @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  providerRule       ProviderConversionRuleConfig @relation(fields: [workspaceId, providerRuleId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([sourceId, whatsappInstanceId, stage])
  @@unique([workspaceId, providerRuleId])
}

model ReportSyncLease {
  id        String   @id
  owner     String
  expiresAt DateTime
  version   Int      @default(1)
}

model ReportSyncRateLimit {
  id     String   @id
  nextAt DateTime
}
